{
  "name": "ngx-morse-ws",
  "version": "2.1.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "test_lib": "ng test ngx-morse",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build_lib": "ng build ngx-morse --configuration production",
    "copy-license": "node -e \"require('fs').copyFileSync('LICENSE', 'dist/ngx-morse/LICENSE')\"",
    "copy-readme": "node -e \"require('fs').copyFileSync('README.md', 'dist/ngx-morse/README.md')\"",
    "copy-files": "npm run copy-license && npm run copy-readme",
    "npm_pack": "cd dist/ngx-morse && npm pack",
    "package": "npm run clean && npm run build_lib && npm run copy-files && npm run npm_pack"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~21.2.26",
    "@angular/cdk": "~21.2.14",
    "@angular/common": "~21.2.26",
    "@angular/compiler": "~21.2.26",
    "@angular/core": "~21.2.26",
    "@angular/forms": "~21.2.26",
    "@angular/material": "~21.2.14",
    "@angular/platform-browser": "~21.2.26",
    "@angular/platform-browser-dynamic": "~21.2.26",
    "@angular/router": "~21.2.26",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~21.2.30",
    "@angular/cli": "~21.2.30",
    "@angular/compiler-cli": "~21.2.26",
    "@angular/language-service": "~21.2.26",
    "@types/jasmine": "~5.1.4",
    "@types/node": "^22.0.0",
    "jasmine-core": "~5.6.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "~21.2.7",
    "typescript": "~5.9.3"
  }
}
